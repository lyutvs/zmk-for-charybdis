#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12

// Layer indices
#define BASE   0
#define SYM    1
#define NAV    2
#define FUN    3
#define SCROLL 4
#define MOUSE  5

// SYM/NAV layer hold is now on left pinky (ESC/TAB positions) so the
// right thumb can roll the trackball without interfering with layer access.

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

// Trackball: normal mouse movement on BASE, scroll on SCROLL layer
&mmv_input_listener {
    input-processors = <&zip_xy_scaler 2 1>;

    scroll {
        layers = <SCROLL>;
        input-processors = <&zip_xy_to_scroll_mapper>;
    };
};

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };

    behaviors {
        // Home Row Mod — urob-style timeless
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    // tri-layer removed: NAV and SYM are now both on the left pinky,
    // making simultaneous hold impossible. FUN is accessed via right
    // outer thumb instead (see layer_0).

    macros {
        // Kept for backward compatibility (unused in current keymap)
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ────────────────────────────────────────────────────────────────
        // BASE — QWERTY + home row mods
        //   Left pinky top: lt(SYM, ESC) — tap=ESC, hold=SYM
        //   Left pinky mid: lt(NAV, TAB) — tap=TAB, hold=NAV
        //   Left thumbs (outer→inner): mo SCROLL / Cmd / Space
        //   Right thumbs: lt(FUN, RET) / CAPS (한/영)
        //   Right pinky top: BSPC (swapped with CAPS)
        //   (Ctrl available via home row D)
        // ────────────────────────────────────────────────────────────────
        layer_0 {
            bindings = <
&lt SYM ESC      &kp Q           &kp W           &kp E            &kp R            &kp T          &kp Y       &kp U            &kp I            &kp O           &kp P              &kp BSPC
&lt NAV TAB      &hm LGUI A      &hm LALT S      &hm LCTRL D      &hm LSHFT F      &kp G          &kp H       &hm RSHFT J      &hm RCTRL K      &hm LALT L      &hm RGUI SEMI      &kp SQT
&kp LSHFT        &kp Z           &kp X           &kp C            &kp V            &kp B          &kp N       &kp M            &kp COMMA        &kp DOT         &kp SLASH          &kp RET
                                                 &mo SCROLL       &kp LGUI         &kp SPACE      &lt FUN RET &kp CAPS
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        // ────────────────────────────────────────────────────────────────
        // SYM — symbols + numbers
        //   Activate: hold right-outer thumb (ENT)
        // ────────────────────────────────────────────────────────────────
        layer_1 {
            bindings = <
&kp N1    &kp N2     &kp N3     &kp N4     &kp N5     &kp N6       &kp N7      &kp N8      &kp N9      &kp N0       &kp MINUS    &trans
&kp GRAVE &kp LGUI   &kp LALT   &kp LCTRL  &kp LSHFT  &trans       &kp EQUAL   &kp LBKT    &kp RBKT    &kp BSLH     &kp SEMI     &kp COLON
&kp TILDE &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT    &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR     &kp RPAR     &kp PIPE
                                &trans     &trans     &trans       &trans      &trans
            >;
        };

        // ────────────────────────────────────────────────────────────────
        // NAV — arrows, Mac shortcuts on left, mouse clicks on left thumb
        //   Activate: hold right-inner thumb (BSPC)
        //   Left thumb (outer→inner): MB3 / MB2 / MB1  (simple click)
        //   Left bottom row: Mac shortcuts at Mac-standard ZXCV positions
        //   G (left index home row right): &tog MOUSE  (for drag-and-drop)
        // ────────────────────────────────────────────────────────────────
        layer_2 {
            bindings = <
&trans   &trans     &trans     &trans     &trans     &trans         &trans         &trans       &trans      &trans      &trans          &trans
&trans   &kp LGUI   &kp LALT   &kp LCTRL  &kp LSHFT  &tog MOUSE     &kp HOME       &kp LEFT     &kp DOWN    &kp UP      &kp RIGHT       &kp END
&trans   &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(LS(Z))  &kp LG(LEFT)   &kp PG_DN    &kp PG_UP   &kp DEL     &kp LG(RIGHT)   &trans
                               &mkp MB3   &mkp MB2   &mkp MB1       &trans         &trans
            >;
        };

        // ────────────────────────────────────────────────────────────────
        // FUN — function keys, Mac system, media, Bluetooth
        //   Activate: tri-layer (NAV + SYM held together)
        // ────────────────────────────────────────────────────────────────
        layer_3 {
            bindings = <
&trans   &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &kp F6      &kp F7       &kp F8       &kp F9       &kp F10     &trans
&trans   &kp C_BRI_DN   &kp C_BRI_UP   &kp LC(UP)     &kp LG(SPACE)  &trans         &kp F11     &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &kp F12     &trans
&trans   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_CLR     &kp C_PREV  &kp C_PP     &kp C_NEXT   &trans       &trans      &trans
                                       &trans         &trans         &trans         &trans      &trans
            >;
        };

        // ──── Unused layers below (preserved as &trans for safety) ──────

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };

        // ────────────────────────────────────────────────────────────────
        // MOUSE — sticky toggle layer for drag-and-drop
        //   Enter/exit: tap G in NAV (or any &tog MOUSE binding)
        //   Hold MB on left thumb + move trackball with right hand
        // ────────────────────────────────────────────────────────────────
        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &tog MOUSE     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans
                        &mkp MB3  &mkp MB2  &mkp MB1   &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };

        layer_10 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };
    };
};
